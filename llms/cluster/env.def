Bootstrap: docker

# torch 2.6, because transformers 5 disables PyTorch below 2.5. CUDA 12.4
# covers the L40S (sm_89) and the H100 (sm_90), and the image carries
# Python 3.11.
From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%post
    # No `apt-get`: every dependency is a wheel on PyPI, and root operations
    # under a root-mapped namespace are where a build fails.
    pip install --no-cache-dir --upgrade pip

    # The libraries only. The repository is reached through PYTHONPATH, so an
    # edit runs without a rebuild. Pinned exactly, because an image is built
    # once and runs for weeks. The API models run outside the container.
    pip install --no-cache-dir \
        "cinnamon-core==2.2.0" \
        "transformers==5.17.0" \
        "accelerate==1.15.0" \
        "pandas==3.0.6"

    # Fail the build here rather than in the first job. The build node has no
    # GPU, so this checks imports and not CUDA.
    python -c "import sys, importlib.metadata as m, cinnamon.registry, transformers, torch, accelerate, pandas; from transformers.utils import is_torch_available; assert is_torch_available(), 'transformers cannot see torch'; print('python ' + sys.version.split()[0] + ' | ' + ' | '.join(p + ' ' + m.version(p) for p in ('cinnamon-core', 'transformers', 'torch', 'accelerate', 'pandas')))"

%environment
    export LC_ALL=C

%runscript
    python "$@"
