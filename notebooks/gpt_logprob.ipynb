   "source": [
    "from openai import OpenAI\n",
    "\n",
    "client = OpenAI(api_key=["YOUR-API-KEY"], base_url=\"https://eu.api.openai.com/v1\")  # picks up OPENAI_API_KEY from env"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "6797f668",
   "metadata": {},
   "outputs": [],
   "source": [
    "def typicality_prompt(obj, category):\n",
    "    return f\"\"\"\n",
    "You are participating in a psychology experiment.\n",
    "\n",
    "Is \"{obj}\" a prototypical example of the category \"{category}\"?\n",
    "Respond with ONLY one word: Yes or No.\n",
    "\"\"\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "get_typicality_fn",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_typicality(obj, category):\n",
    "    prompt = typicality_prompt(obj, category)  # your existing Yes/No prompt\n",
    "\n",
    "    response = client.chat.completions.create(\n",
    "        model=\"gpt-5.4\",\n",
    "        messages=[{\"role\": \"user\", \"content\": prompt}],\n",
    "        #max_tokens=1,\n",
    "        temperature=0,\n",
    "        logprobs=True,\n",
    "        top_logprobs=5,\n",
    "    )\n",
    "\n",
    "    top_logprobs = response.choices[0].logprobs.content[0].top_logprobs\n",
    "    probs = {t.token: 2.718281828 ** t.logprob for t in top_logprobs}\n",
    "\n",
    "    p_yes = probs.get(\"Yes\", 0.0)\n",
    "    p_no = probs.get(\"No\", 0.0)\n",
    "\n",
    "    if (p_yes + p_no) < 1e-6:\n",
    "        print(f\"Warning: near-zero Yes/No mass for '{obj}' ({category}). Top tokens: {probs}\")\n",
    "        return None\n",
    "\n",
    "    return p_yes / (p_yes + p_no)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "07abe1e4-3b3d-4c29-b2e6-ea63fae542b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Reset column in case a previous buggy run stored prompt text instead of scores\n",
    "df[\"gpt_typicality\"] = pd.to_numeric(df[\"gpt_typicality\"], errors=\"coerce\") if \"gpt_typicality\" in df.columns else None\n",
    "\n",
    "output_path = f\"combined_prototypes_{LANGUAGE}.csv\"\n",
    "\n",
    "for idx, row in df.iterrows():\n",
    "    if pd.notna(df.at[idx, \"gpt_typicality\"]):\n",
    "        continue  # already done, skip (useful on resume)\n",
    "    score = get_typicality(row[instance_col], row[\"category\"])\n",
    "    df.at[idx, \"gpt_typicality\"] = score\n",
    "    df.to_csv(output_path, index=False)\n"
   ]
  },
