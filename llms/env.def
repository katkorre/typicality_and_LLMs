Bootstrap: docker

From: pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

%post

    apt-get update
    apt-get -y install git

    # Install your Python requirements here
    pip install transformers pandas numpy bitsandbytes lightning nltk accelerate

%environment
    export LC_ALL=C
    export PYTHONPATH="$PYTHONPATH:/."

%runscript

    # Command executed when you use `apptainer run`

    python "$@"

